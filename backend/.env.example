BACKEND_PORT=4000
BACKEND_HOST=127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017/zonify
APP_ORIGIN=http://localhost:3000
# Generate a secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SEED_CUSTOMER_EMAIL=customer@zonify.test
SEED_CUSTOMER_PASSWORD=
SEED_MANAGER_EMAIL=manager@zonify.test
SEED_MANAGER_PASSWORD=
SEED_OWNER_EMAIL=owner@zonify.test
SEED_OWNER_PASSWORD=
# Optional Bangkok calendar date for sample stall statuses; defaults to today.
# SEED_DATE=2026-10-11
# Receiving PromptPay account. Leave blank to disable QR generation.
# Accepts a Thai mobile number (10 digits starting 0) or national/tax ID (13 digits).
PROMPTPAY_ID=
PROMPTPAY_NAME=
# Optional host-side backup tools (MongoDB Database Tools, not the mongod server).
# MONGODUMP_PATH=C:/Tools/mongodb/bin/mongodump.exe
# MONGORESTORE_PATH=C:/Tools/mongodb/bin/mongorestore.exe
# BACKUP_API_URL=http://127.0.0.1:4000/health
